# Where the FastAPI backend is listening. The dev server proxies /api here, so
# the browser stays same-origin and the backend needs no CORS configuration.
# Use 127.0.0.1, not localhost: Node 18 resolves localhost to ::1 (IPv6) while
# uvicorn binds IPv4 only by default, which breaks the proxy.
VITE_API_URL=http://127.0.0.1:8000

# Port for the Vite dev server itself.
VITE_PORT=5173

# true runs the UI against an in-memory double instead of the backend, which is
# useful for working on the interface with nothing else running. A "mock data"
# badge appears in the top bar whenever it is on.
VITE_USE_MOCKS=false
